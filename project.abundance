                  "uniqueID": "id-152",
                  "ioValues": [
                    {
                      "name": "ringDiameter",
                      "ioValue": 394.3
                    },
                    {
                      "name": "wireDiameter",
                      "ioValue": 3.5
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Shade Ring: round steel wire bent into a closed ring (a torus).\n * ringDiameter is measured to the wire's centerline; the ring lies in the XY\n * plane centered on the origin.\n */\nfunction run(ringDiameter: number = 394.3, wireDiameter: number = 3.5): Assembly {\n  // Circle of the wire's cross-section, drawn at the ring radius in the XZ plane,\n  // revolved a full turn about Z.\n  const ring = replicad\n    .drawCircle(wireDiameter / 2)\n    .translate(ringDiameter / 2, 0)\n    .sketchOnPlane(\"XZ\")\n    .revolve();\n  return new Assembly({ geometry: ring, color: \"#3A3A3A\", tags: [\"shade ring\"] });\n}",
                  "compiledCode": "\"use strict\";\n/**\n * Shade Ring: round steel wire bent into a closed ring (a torus).\n * ringDiameter is measured to the wire's centerline; the ring lies in the XY\n * plane centered on the origin.\n */\nfunction run(ringDiameter = 394.3, wireDiameter = 3.5) {\n    // Circle of the wire's cross-section, drawn at the ring radius in the XZ plane,\n    // revolved a full turn about Z.\n    const ring = replicad\n        .drawCircle(wireDiameter / 2)\n        .translate(ringDiameter / 2, 0)\n        .sketchOnPlane(\"XZ\")\n        .revolve();\n    return new Assembly({ geometry: ring, color: \"#3A3A3A\", tags: [\"shade ring\"] });\n}\n"
                }
